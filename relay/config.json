{
  "port": 7099,
  "adminSecret": "CHANGE-ME-generate-an-admin-secret",
  "sharedSecret": "CHANGE-ME-generate-a-real-secret",
  "legacyAuthEnabled": true,
  "relayUrl": "",
  "machines": [
    {
      "machineId": "machine-2",
      "description": "Worker machine 2",
      "defaultWorkingDir": "C:/workspace"
    }
  ],
  "tls": {
    "enabled": false
  },
  "discovery": {
    "enabled": false
  },
  "heartbeat": {
    "intervalMs": 30000,
    "timeoutMs": 10000
  },
  "loadBalancing": {
    "strategy": "least-busy"
  },
  "rateLimiting": {
    "enabled": true,
    "maxTasksPerMinute": 20,
    "maxTasksPerHour": 200
  },
  "limits": {
    "maxPromptLength": 50000,
    "maxOutputLength": 1000000,
    "maxRequestBodyBytes": 102400
  },
  "keepAwake": {
    "enabled": false
  },
  "queue": {
    "enabled": true,
    "maxQueueSize": 100
  },
  "pin": {
    "enabled": true,
    "code": "9999",
    "maxAttempts": 5,
    "lockoutMinutes": 15
  }
}